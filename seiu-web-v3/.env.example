# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# OpenAI dùng cho AI viết bài và chấm bài trên Netlify Functions.
# Không đặt khóa này trong mã frontend hoặc biến có tiền tố VITE_.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TTS_FEMALE_VOICE="marin"
OPENAI_TTS_MALE_VOICE="cedar"

# Khuyên dùng cho giọng Hàn nam/nữ tự nhiên, đúng locale ko-KR.
# Nếu có Azure Speech, hệ thống ưu tiên Azure; nếu không sẽ dùng OpenAI TTS.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
AZURE_TTS_FEMALE_VOICE="ko-KR-SunHiNeural"
AZURE_TTS_MALE_VOICE="ko-KR-InJoonNeural"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Cổng quản trị: chỉ điền khi muốn thay tài khoản đã được cấu hình sẵn.
# Không dùng tiền tố VITE_ và không đưa các giá trị này vào mã frontend.
SEIU_ADMIN_USER=""
SEIU_ADMIN_PASSWORD=""
SEIU_ADMIN_PASSWORD_HASH=""
SEIU_ADMIN_TOKEN_SECRET=""

# Optional notifications for new consultation forms.
SEIU_SHEET_WEBHOOK=""
SEIU_TELEGRAM_TOKEN=""
SEIU_TELEGRAM_CHAT=""
